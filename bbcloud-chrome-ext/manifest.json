{
  "manifest_version": 3,
  "name": "Bitbucket Cloud: Open in IntelliJ",
  "version": "1.1.0",
  "description": "Adds an Open in IntelliJ icon next to pull requests on bitbucket.org list and detail pages; opens them in a git worktree in a running IntelliJ IDE.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://bitbucket.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png"],
      "matches": ["https://bitbucket.org/*"]
    }
  ],
  "key" : ""
}
